# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller build definition for the standalone Windows executable."""

from PyInstaller.utils.hooks import collect_submodules

hiddenimports = collect_submodules("aegis_scan")

a = Analysis(
    ["aegis.py"],
    pathex=[],
    binaries=[],
    datas=[],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["tkinter", "unittest", "pydoc", "distutils", "setuptools", "pip"],
    noarchive=False,
    optimize=1,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="AEGIS",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon="packaging/aegis.ico",
    version="packaging/version_info.txt",
)
